# Copy to .env.local: `cp .env.example .env.local`, then fill in the four secrets below.
# Every pnpm script loads .env.local through dotenv-cli; nothing reads .env by itself.

# Local Supabase (supabase/config.toml: db on :55322). Runtime queries and the Prisma CLI use the same DB locally.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"

# Jev (TypeSafe System One decision model) through OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=""
# Optional: pin a Jev version instead of ~typesafe/jev-latest
# JEV_MODEL="typesafe/jev-1.14-20261014"

# Trigger.dev v4 project (https://cloud.trigger.dev): Project settings → API keys → the DEV secret key (tr_dev_…)
TRIGGER_SECRET_KEY=""
# Project ref, e.g. proj_abc123 (trigger.config.ts reads it)
TRIGGER_PROJECT_REF=""
# Personal access token (Account → Personal access tokens, tr_pat_…); lets `pnpm trigger:dev` reach the project
TRIGGER_ACCESS_TOKEN=""

# Shared secret for POST /api/webhooks/bahn (header x-bahn-webhook-secret); the simulator sends it
BAHN_WEBHOOK_SECRET="local-bahn-webhook-secret"

# Agent blocks run the Claude Code CLI headless. A logged-in CLI (`claude` → /login) needs nothing here;
# otherwise set an API key. CLAUDE_BIN overrides where the binary is (default ~/.local/bin/claude, then PATH).
# ANTHROPIC_API_KEY=""
# CLAUDE_BIN="/path/to/claude"

# Optional adapters and switches (defaults shown)
# DECISION_MODEL="jev"            # lib/decisions registry
# AGENT_RUNNER="claude-cli"       # lib/agents registry
# TRAVEL_PROVIDER="mock"          # ferries, trains, hotels (lib/providers)
# ROADSIDE_PROVIDER="mock"
# DRIVER_POOL_PROVIDER="mock"
# CONVERSATION_PROVIDER="sim"     # simulated driver / site replies
# CONVERSATION_SCRIPTS="on"       # lib/providers/scripts/<orderRef>.json scripted demo replies; "off" = persona only
# BAHN_WEBHOOK_URL="http://localhost:3001/api/webhooks/bahn"
