  accessNote    String? @map("access_note")
  addressLine1  String? @map("address_line1")
  boundary      String?
  city          String
  country       String
  kind          String
  managedSiteId String? @map("managed_site_id")
  name          String
  openingHours  Json?   @map("opening_hours")
  orderId       String? @map("order_id")
  rawInput      String  @map("raw_input")
  timezone      String
  raw           Json

  @@index([orderId])
  @@map("addresses")
  @@schema("bahn")
}

