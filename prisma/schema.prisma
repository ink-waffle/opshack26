generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["bahn", "control"]
}

// ───────────────────────────── control: our service ─────────────────────────────

// Ordered weakest → strongest; lib/evidence owns the semantics.
enum EvidenceLevel {
  REQUESTED
  STATED
  QUOTED
  PLANNED
  BOOKED
  OBSERVED
  VERIFIED

  @@schema("control")
}

enum FactSourceType {
  BAHN_RECORD
  TOOL
  OPERATOR
  AGENT_INTERPRETATION

  @@schema("control")
}

enum RunStatus {
  DETECTED
  GATHERING
  OPTIONS_READY
  AWAITING_DECISION
  EXECUTING
  CLOSED
  ESCALATED
  FAILED

  @@schema("control")
}

enum BlockKind {
  deterministic
  agent
  wait
  human
  execute

  @@schema("control")
}

enum BlockRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  SKIPPED

  @@schema("control")
}

enum CardKind {
  DECISION
  TRIAGE

  @@schema("control")
}

enum CardStatus {
  OPEN
  APPROVED
  EDITED
  REJECTED
  EXPIRED
  CANCELLED

  @@schema("control")
}

enum AmendmentKind {
  INSTRUCTION
  PARAMETER

  @@schema("control")
}

enum AmendmentStatus {
  PROPOSED
  APPROVED
  REJECTED

  @@schema("control")
}

// Written only by lib/facts; observedAt is sim time, dedupeKey makes projections idempotent.
model Fact {
  id         String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId    String?        @map("order_id")
  runId      String?        @map("run_id")
  kind       String
  subject    String
  statement  String
  value      Json?
  level      EvidenceLevel
  sourceType FactSourceType @map("source_type")
  sourceRef  String         @map("source_ref")
  dedupeKey  String?        @unique @map("dedupe_key")
  observedAt DateTime       @map("observed_at") @db.Timestamptz(3)
  recordedAt DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(3)

  @@index([orderId, kind])
  @@index([runId])
  @@index([subject])
  @@map("facts")
  @@schema("control")
}

// One watchman inspection (Jev answers or a deterministic monitor hit) and where it was routed.
model Signal {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId     String?  @map("order_id")
  source      String
  sourceRef   String?  @map("source_ref")
  triggerType String?  @map("trigger_type")
  probability Float?
  state       Json?
  answers     Json?
  routing     Json?
  runId       String?  @map("run_id")
  simAt       DateTime @map("sim_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId, simAt])
  @@index([triggerType])
  @@map("signals")
  @@schema("control")
}

model PlaybookRun {
  id             String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  playbookId     String     @map("playbook_id")
  orderId        String?    @map("order_id")
  triggerType    String?    @map("trigger_type")
  signalId       String?    @map("signal_id")
  status         RunStatus  @default(DETECTED)
  triggerRunId   String?    @map("trigger_run_id")
  currentBlockId String?    @map("current_block_id")
  context        Json?
  result         Json?
  error          String?
  simStartedAt   DateTime?  @map("sim_started_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt       DateTime?  @map("closed_at") @db.Timestamptz(3)
  blockRuns      BlockRun[]
  cards          Card[]

  @@index([orderId])
  @@index([status])
  @@index([playbookId, createdAt])
  @@map("playbook_runs")
  @@schema("control")
}

model BlockRun {
  id         String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  runId      String         @map("run_id")
  run        PlaybookRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  blockId    String         @map("block_id")
  kind       BlockKind
  status     BlockRunStatus @default(RUNNING)
  input      Json?
  output     Json?
  error      String?
  model      String?
  costUsd    Float?         @map("cost_usd")
  durationMs Int?           @map("duration_ms")
  transcript Json?
  startedAt  DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?      @map("finished_at") @db.Timestamptz(3)

  @@index([runId, startedAt])
  @@map("block_runs")
  @@schema("control")
}

// Operator decision card; decideBy is sim time and drives the control-room sort.
model Card {
  id               String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  runId            String?      @map("run_id")
  run              PlaybookRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  orderId          String?      @map("order_id")
  playbookId       String?      @map("playbook_id")
  blockId          String?      @map("block_id")
  kind             CardKind     @default(DECISION)
  status           CardStatus   @default(OPEN)
  title            String
  summary          String
  agentActions     Json?        @map("agent_actions")
  factIds          String[]     @default([]) @map("fact_ids")
  options          Json?
  decideBy         DateTime?    @map("decide_by") @db.Timestamptz(3)
  decideByReason   String?      @map("decide_by_reason")
  decision         Json?
  decidedBy        String?      @map("decided_by")
  decidedAt        DateTime?    @map("decided_at") @db.Timestamptz(3)
  waitpointTokenId String?      @map("waitpoint_token_id")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, decideBy])
  @@index([orderId])
  @@index([runId])
  @@map("cards")
  @@schema("control")
}

model Amendment {
  id           String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  playbookId   String          @map("playbook_id")
  blockId      String?         @map("block_id")
  kind         AmendmentKind
  text         String
  parameters   Json?
  rationale    String?
  sourceCardId String?         @map("source_card_id")
  backtest     Json?
  status       AmendmentStatus @default(PROPOSED)
  proposedBy   String?         @map("proposed_by")
  decidedBy    String?         @map("decided_by")
  decidedAt    DateTime?       @map("decided_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([playbookId, status])
  @@index([sourceCardId])
  @@map("amendments")
  @@schema("control")
}

// Single row (id 'default'): simNow = anchorSim + (realNow - anchorReal) * speed.
model SimClock {
  id         String   @id @default("default")
  anchorSim  DateTime @map("anchor_sim") @db.Timestamptz(3)
  anchorReal DateTime @map("anchor_real") @db.Timestamptz(3)
  speed      Float    @default(1)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sim_clock")
  @@schema("control")
}

// ───────────────────── bahn: Bahn's system, seeded from data/bahn/dataset ─────────────────────
// One model per collection: typed columns named like the JSON keys plus `raw` (the full record).
// Generated from the dataset profile; scripts/seed/bahn.ts fills columns by key via jsonb_populate_recordset.

model BahnAddress {
