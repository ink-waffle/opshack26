or": "rntn", "children": [42623852, 42624055, 42624057, 42624094, 42624104], "created_at": "2025-01-07T15:12:05Z", "created_at_i": 1736262725, "num_comments": 4, "objectID": "42623163", "points": 19, "story_id": 42623163, "title": "Google is building its own 'world modeling' AI team for games and robot training", "updated_at": "2025-01-09T21:25:51Z", "url": "https://www.theverge.com/2025/1/7/24338053/google-deepmind-world-modeling-ai-team-gaming-robot-training"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "kaarelson"}, "title": {"fullyHighlighted": false, "matchLevel": "full", "matchedWords": ["world", "model"], "value": "Open-weights <em>world</em> <em>models</em>' parameter size doubles every ~6 months"}, "url": {"matchLevel": "none", "matchedWords": [], "value": "https://twitter.com/kaarelkaarelson/status/2098472992821199358"}}, "_tags": ["story", "author_kaarelson", "story_49662740"], "author": "kaarelson", "children": [49662899, 49663403, 49663962], "created_at": "2026-09-11T18:09:18Z", "created_at_i": 1789150158, "num_comments": 9, "objectID": "49662740", "points": 16, "story_id": 49662740, "title": "Open-weights world models' parameter size doubles every ~6 months", "updated_at": "2026-09-18T21:10:05Z", "url": "https://twitter.com/kaarelkaarelson/status/2098472992821199358"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "tosh"}, "title": {"fullyHighlighted": false, "matchLevel": "full", "matchedWords": ["world", "model"], "value": "Code <em>World</em> <em>Model</em>"}, "url": {"matchLevel": "none", "matchedWords": [], "value": "https://github.com/facebookresearch/cwm"}}, "_tags": ["story", "author_tosh", "story_46814448"], "author": "tosh", "children": [46818395, 46818611], "created_at": "2026-01-29T18:37:34Z", "created_at_i": 1769711854, "num_comments": 5, "objectID": "46814448", "points": 15, "story_id": 46814448, "title": "Code World Model", "updated_at": "2026-03-05T23:26:22Z", "url": "https://github.com/facebookresearch/cwm"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "lcastricato"}, "story_text": {"fullyHighlighted": false, "matchLevel": "full", "matchedWords": ["world", "model"], "value": "Over the last few weeks, <em>world</em> models have started to feel real for the first time. You can see coherent environments, long rollouts, and increasingly convincing visuals. At the same time, most of these systems are hard to run, hard to integrate, and trade interactivity for scale.<p>We started Overworld because we cared less about producing impressive videos and more about building worlds you can actually inhabit. That means low latency, continuous control, and systems that respond every time you act, not once per prompt.<p>Last week, we released Waypoint 1, a research preview of a real-time diffusion <em>world</em> <em>model</em> that runs locally. Next week, we\u2019re releasing Waypoint 1.1 Small, which is designed to run on modern consumer GPUs and be easy to build on and modify.<p>Waypoint is built from scratch rather than fine-tuned from a large video <em>model</em>. We optimized heavily for control frequency, sparse attention, and fast inference so the system can maintain a persistent <em>world</em> state and respond to input at game-level frame rates. The goal was to make something developers can integrate today, not just watch as a demo.<p>We think this space will move fastest once <em>world</em> models follow a path similar to LLMs: local execution, open tooling, and fast community-driven iteration. Genie and similar systems show what\u2019s possible at a massive scale. Our focus has been on making that future local and accessible.<p>We wrote more about the \u201cimmersion gap,\u201d why interactivity matters more than visuals alone, and how we optimized the <em>model</em> in a recent blog post.<p>Code, demos, and release details are here: https://over.<em>world</em>/blog/the-immersion-gap